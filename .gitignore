# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release


# Flutter/Dart specific files
.dart_tool/
.idea/
.packages
pubspec.lock  # You can choose to leave this if you want to lock dependencies, but typically leave it for app development

# Build files (ignore build outputs but don't affect app development)
build/

# Gradle-related files (don't affect app code)
.gradle/
gradle-wrapper.jar
gradle-wrapper.properties
*.gradle

# Android-specific files (ignore Android build files, but leave source code)
# This can be adjusted if you have custom Android code, but typically:
android/.gradle/
android/build/
